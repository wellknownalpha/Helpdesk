# Database (native dev workflow)
DATABASE_URL="postgresql://nexusdesk:nexusdesk_secret@localhost:5433/nexusdesk?schema=public"
# Auth.js — REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Public URL of the app (used for auth callbacks). On EC2: http://<ec2-ip-or-domain>:3002
APP_URL="http://localhost:3002"
AUTH_URL="http://localhost:3002"
NEXTAUTH_URL="http://localhost:3002"
# App
NEXT_PUBLIC_APP_NAME="NexusDesk"
# ---- Email: outbound (SMTP). Local default = MailHog catcher on :1025/:8025.
# Production example (Gmail): SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false
#   SMTP_USER=support@yourcompany.com SMTP_PASS=<app-password> SMTP_FROM="Support <support@yourcompany.com>"
NOTIFICATIONS_ENABLED="true"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NexusDesk <support@nexusdesk.local>"
SUPPORT_MAILBOX="support@nexusdesk.local"
# ---- Email: inbound ----
INBOUND_WEBHOOK_SECRET="change-me-in-production"
MAIL_INBOUND_ENABLED="false"
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASS=""
IMAP_MAILBOX="INBOX"
IMAP_POLL_SECONDS="60"
